{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": ["WebFetch", "WebSearch"],
    "deny": [
      "Edit(~/**)",
      "Edit(//tmp/**)",
      "Edit(//var/tmp/**)",
      "Edit(//dev/shm/**)",
      "mcp__claude-artifacts",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "SendFeedback",
      "SendToProject",
      "SendToProjectContext"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.config/atc", "~/.ssh"]
    },
    "network": {
      "allowedDomains": []
    }
  }
}

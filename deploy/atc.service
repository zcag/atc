[Unit]
Description=atc, every Claude Code session in one place
After=network-online.target

[Service]
EnvironmentFile=-%h/.config/atc/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/atc serve
Restart=always
RestartSec=5
KillMode=process
MemorySwapMax=0

[Install]
WantedBy=default.target

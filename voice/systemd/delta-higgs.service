[Unit]
Description=atc voice: Higgs TTS 3 (Boson, research licence) on the GPU through audio.cpp (Vulkan), :8841, set up by hand under HIGGS_DIR
After=network-online.target

[Service]
Slice=calls.slice
Environment=HIGGS_DIR=%h/.local/share/atc/voice/audiocpp
EnvironmentFile=-%h/.config/atc/voice.env
ExecStart=/bin/sh -c 'cd "$$HIGGS_DIR/bin" && LD_LIBRARY_PATH="$$HIGGS_DIR/bin" exec ./audiocpp_server --config "$$HIGGS_DIR/server.json"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

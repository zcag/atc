[Unit]
Description=atc voice: the call line as a WebSocket, :8807 (call state, answer, dial, audio both ways)
After=network-online.target

[Service]
Slice=calls.slice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ATC_VOICE_DIR=%h/.local/share/atc/voice
Environment=TALK_STATE=%h/.local/state/atc/voice
Environment=DELTA_CALL_BRIDGE=0
EnvironmentFile=-%h/.config/atc/voice.env
ExecStart=/usr/bin/env uv run --script ${ATC_VOICE_DIR}/call.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

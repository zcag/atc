[Unit]
Description=atc voice: answers calls on atc's app line, beside delta-talk on the device line, so both can be on a call at once
After=delta-call.service atc-hub.service delta-tts.service delta-higgs.service
Wants=delta-call.service delta-tts.service

[Service]
Slice=calls.slice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ATC_VOICE_DIR=%h/.local/share/atc/voice
Environment=TALK_STATE=%h/.local/state/atc/voice
Environment=TALK_MODELS=%h/.cache/atc/voice
Environment=HF_HOME=%h/.cache/atc/voice/hf
EnvironmentFile=-%h/.config/atc/voice.env
ExecStart=/usr/bin/env uv run --script ${ATC_VOICE_DIR}/talk.py --loop --smart-turn --end-ms 1500 --stt stream --brain hub --line app --out ${TALK_STATE}/calls $TALK_ARGS
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

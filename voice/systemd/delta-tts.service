[Unit]
Description=atc voice: streaming TTS for calls, POST :8812/v1/audio/speech
After=network-online.target

[Service]
Slice=calls.slice
Environment=ATC_VOICE_DIR=%h/.local/share/atc/voice
Environment=TTS_VENV=%h/.local/share/atc/voice/tts-venv
Environment=TTS_HF_HOME=%h/.cache/atc/voice/hf
Environment=TTS_ENGINES=pocket-en
Environment=TTS_PORT=8812
EnvironmentFile=-%h/.config/atc/voice.env
ExecStart=/usr/bin/env HF_HOME=${TTS_HF_HOME} ${TTS_VENV}/bin/python ${ATC_VOICE_DIR}/ttsd.py --engine ${TTS_ENGINES} --port ${TTS_PORT} $TTS_ARGS
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

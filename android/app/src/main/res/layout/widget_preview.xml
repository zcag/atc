<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/app_name"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            style="@style/WidgetBlock"
            android:background="@drawable/w_fill"
            android:backgroundTint="@color/needs"
            android:text="1"
            android:textColor="#2b2215" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/needs" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_title"
                android:textColor="@color/w_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_ask"
                android:textColor="@color/w_ink"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetChip"
                    android:background="@drawable/w_chip_fill"
                    android:backgroundTint="@color/w_ink"
                    android:text="@string/preview_a"
                    android:textColor="@color/w_bg"
                    android:textStyle="bold" />

                <TextView
                    style="@style/WidgetChip"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/w_chip_line"
                    android:backgroundTint="@color/w_faint"
                    android:text="@string/preview_b" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/preview_said"
            android:textColor="@color/w_ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/w_talk"
            android:backgroundTint="@color/w_ink"
            android:gravity="center"
            android:text="Talk"
            android:textColor="@color/w_bg"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

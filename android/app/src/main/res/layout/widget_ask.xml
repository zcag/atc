<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ask_rule"
        style="@style/WidgetRule"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/ask_edge"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/w_fill" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ask_sb"
                    style="@style/WidgetBlock"
                    android:background="@drawable/w_fill"
                    android:text="N" />

                <TextView
                    android:id="@+id/ask_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/w_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ask_where"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="@color/w_faint"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ask_q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/w_ink"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ask_opts"
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opt0"
                    style="@style/WidgetChip"
                    android:background="@drawable/w_chip_fill"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/opt1"
                    style="@style/WidgetChip"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/w_chip_line" />

                <TextView
                    android:id="@+id/opt2"
                    style="@style/WidgetChip"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/w_chip_line" />
            </LinearLayout>

            <TextView
                android:id="@+id/ask_st"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textColor="@color/w_dim"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/head"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textColor="@color/w_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/h_needs"
        style="@style/WidgetBlock"
        android:layout_marginEnd="6dp"
        android:background="@drawable/w_fill" />

    <TextView
        android:id="@+id/h_turn"
        style="@style/WidgetBlock"
        android:layout_marginEnd="6dp"
        android:background="@drawable/w_box" />

    <ImageView
        android:id="@+id/h_work_bar"
        android:layout_width="2dp"
        android:layout_height="11dp"
        android:layout_marginEnd="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_fill" />

    <TextView
        android:id="@+id/h_work"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textColor="@color/w_dim"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/more"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:textColor="@color/w_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textColor="@color/w_faint"
        android:textSize="10sp" />
</LinearLayout>
